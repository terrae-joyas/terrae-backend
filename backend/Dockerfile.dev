# ============================================================
# Terrae Backend — Dockerfile de DESARROLLO
# Hot-reload habilitado. Para producción se usará un Dockerfile
# multi-stage separado (se define en la Etapa 22).
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# Dependencias de sistema mínimas (compilación de paquetes Python)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY . .

RUN chmod +x docker-entrypoint.dev.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["./docker-entrypoint.dev.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
