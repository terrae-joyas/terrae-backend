# ============================================================
# TERRAE — .gitignore (monorepo)
# ============================================================

# --- Entorno y secretos ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# --- Python / FastAPI / IA ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
instance/

# Datasets e IA (pesados, no versionar binarios grandes)
ai/datasets/raw/
ai/models/*.pt
ai/models/*.pth
ai/models/*.onnx
ai/models/checkpoints/
*.h5

# --- Node / React / Next.js ---
node_modules/
.next/
out/
dist/
build/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml
.eslintcache
next-env.d.ts

# Copia generada automáticamente por scripts/sync-simulator.sh
# (la fuente de verdad es frontend/simulator/, esta es solo para servir
# el simulador desde el dev server de Next.js)
frontend/public/simulator/

# --- Base de datos ---
*.sqlite3
*.db
database/backups/
postgres-data/

# --- Blockchain / Hardhat / Solidity ---
blockchain/cache/
blockchain/artifacts/
blockchain/typechain/
blockchain/typechain-types/

# --- Docker ---
*.pid

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editores / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Logs ---
logs/
*.log

# --- Archivos temporales ---
tmp/
temp/
*.tmp

# Datos generados en runtime (no versionar: se recrean con la semilla demo)
backend/app/infrastructure/data/*.json

# --- Certificados y capturas SIEGEM Lab (datos reales sensibles) ---
ai/datasets/capturas_privadas/
