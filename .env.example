# ============================================================
# TERRAE — Variables de entorno de referencia
# Copiar como .env y completar con valores reales.
# NUNCA subir el archivo .env real al repositorio.
# ============================================================

# --- Entorno ---
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=changeme-generate-a-secure-random-key
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000

# --- Autenticación (JWT) ---
JWT_SECRET_KEY=changeme-generate-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://terrae_user:changeme@localhost:5432/terrae_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=terrae_db
DATABASE_USER=terrae_user
DATABASE_PASSWORD=changeme

# --- Blockchain (Polygon) ---
BLOCKCHAIN_GATEWAY_MODE=simulado    # simulado | real
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
CONTRACT_ADDRESS=
WALLET_PRIVATE_KEY=

# --- Storage (Supabase / IPFS) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PINATA_API_KEY=
PINATA_SECRET_KEY=

# --- IA / SIEGEM Lab ---
AI_MODEL_PATH=./ai/models
AI_INFERENCE_DEVICE=cpu             # cpu | cuda

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
